{
  "name": "valentine-annihilation-committee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "バレンタイン撲滅委員会 - MVP",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:prepare": "npm test && npm run build && npm run verify:web && cap sync android && node scripts/android-build.mjs verify",
    "verify:web": "vitest run --config scripts/vitest.bundle.config.ts",
    "test:packaging": "node scripts/android-build.mjs test",
    "android:release": "node scripts/android-build.mjs release",
    "android:unsigned": "node scripts/android-build.mjs unsigned",
    "android:verify-aab": "node scripts/android-build.mjs aab",
    "android:debug": "node scripts/android-build.mjs debug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
